diff --git a/app/test/unit/model/nearby_devices_state_test.dart b/app/test/unit/model/nearby_devices_state_test.dart
new file mode 100644
index 0000000..6a401d5
--- /dev/null
+++ b/app/test/unit/model/nearby_devices_state_test.dart
@@ -0,0 +1,63 @@
+import 'package:relaysend_app/model/state/nearby_devices_state.dart';
+import 'package:localsend_isolates/model/device.dart';
+import 'package:test/test.dart';
+
+void main() {
+  test('allDevices prefers the latest signaling id and keeps channels', () {
+    final state = NearbyDevicesState(
+      runningFavoriteScan: false,
+      runningIps: {},
+      devices: {
+        'fp': _device(
+          signalingId: null,
+          ip: '192.168.1.2',
+        ),
+      },
+      signalingDevices: {
+        'fp': {
+          _device(
+            signalingId: 'old-id',
+            server: 'wss://old-relay.example',
+          ),
+          _device(
+            signalingId: 'new-id',
+            server: 'wss://new-relay.example',
+          ),
+        },
+      },
+    );
+
+    final merged = state.allDevices['fp']!;
+
+    expect(merged.signalingId, 'new-id');
+    expect(
+      merged.channels.whereType<SignalingChannel>().map((channel) => channel.signalingServer),
+      containsAll([
+        'wss://old-relay.example',
+        'wss://new-relay.example',
+      ]),
+    );
+  });
+}
+
+Device _device({
+  required String? signalingId,
+  String? ip,
+  String? server,
+}) {
+  return Device(
+    signalingId: signalingId,
+    ip: ip,
+    version: '1',
+    port: ip == null ? -1 : 53317,
+    https: false,
+    fingerprint: 'fp',
+    alias: 'Phone',
+    deviceModel: 'Test',
+    deviceType: DeviceType.mobile,
+    download: false,
+    channels: [
+      if (server != null) SignalingChannel(signalingServer: server),
+    ],
+  );
+}
