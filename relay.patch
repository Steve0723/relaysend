+import 'package:localsend_app/provider/network/webrtc/webrtc_receiver.dart';
+import 'package:refena_flutter/refena_flutter.dart';
+
+/// A live handle to a WebRTC receive session, used by pages that are not
+/// created inside [WebRTCReceiveService] (notably [ProgressPage]).
+class WebRTCReceiveSessionHandle {
+  final String sessionId;
+  final ReduxProvider<WebRTCReceiveService, WebRTCReceiveState> provider;
+
+  const WebRTCReceiveSessionHandle({
+    required this.sessionId,
+    required this.provider,
+  });
+}
+
+/// Tracks active WebRTC receive sessions by the session id from the SDP offer.
+final webRTCReceiveSessionsProvider = NotifierProvider<WebRTCReceiveSessionsService, Map<String, WebRTCReceiveSessionHandle>>((ref) {
+  return WebRTCReceiveSessionsService();
+});
+
+class WebRTCReceiveSessionsService extends Notifier<Map<String, WebRTCReceiveSessionHandle>> {
+  @override
+  Map<String, WebRTCReceiveSessionHandle> init() => {};
+
+  void register(WebRTCReceiveSessionHandle handle) {
+    state = {
+      ...state,
+      handle.sessionId: handle,
+    };
+  }
+
+  void unregister(String sessionId) {
+    state = {...state}..remove(sessionId);
+  }
+}
