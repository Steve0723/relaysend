+    SignalingChannel? signalingChannel;
+    final signalingState = ref.read(signalingProvider);
+    for (final channel in resolvedTarget.channels.whereType<SignalingChannel>()) {
+      if (signalingServers.contains(channel.signalingServer) && signalingState.connections.containsKey(channel.signalingServer)) {
+        signalingChannel = channel;
+        break;
+      }
+    }
+
+    final connection = signalingChannel == null ? null : signalingState.connections[signalingChannel.signalingServer];
+    final signalingId = resolvedTarget.signalingId;
