+class AcceptSelectionAction extends AsyncReduxAction<WebRTCReceiveService, WebRTCReceiveState> {
+  final Map<String, String> selection;
+
+  AcceptSelectionAction({required this.selection});
+
+  @override
+  Future<WebRTCReceiveState> reduce() async {
+    final controller = state.controller;
+    final session = state.sessionState;
+    if (controller == null || session == null) {
+      return state;
+    }
+
+    final message = session.message;
+    if (message != null) {
+      await controller.sendSelection(selection: {});
+      await external(notifier._receiveHistory).dispatchAsync(
+        AddHistoryEntryAction(
+          entryId: const Uuid().v4(),
+          fileName: message,
+          fileType: FileType.text,
+          path: null,
+          savedToGallery: false,
+          isMessage: true,
+          fileSize: utf8.encode(message).length,
+          senderAlias: session.senderAlias,
+          timestamp: DateTime.now().toUtc(),
+        ),
+      );
+      dispatch(CloseSessionAction());
+      return state;
+    }
+
+    if (selection.isEmpty) {
+      await controller.sendSelection(selection: {});
+      dispatch(CloseSessionAction());
+      return state;
+    }
+
+    final updatedSession = session.copyWith(
+      status: SessionStatus.sending,
+      files: Map.fromEntries(
+        session.files.values.map((entry) {
+          final desiredName = selection[entry.file.id];
+          return MapEntry(
+            entry.file.id,
+            ReceivingFile(
+              file: entry.file,
+              token: null,
+              desiredName: desiredName,
+              path: null,
+              savedToGallery: false,
+              errorMessage: null,
+            ),
+          );
+        }),
+      ),
+    );
+
+    notifier._fileTransfer.setStatuses(
+      sessionId: session.sessionId,
+      statuses: {
+        for (final file in session.files.values) file.file.id: selection.containsKey(file.file.id) ? FileStatus.queue : FileStatus.skipped,
+      },
+    );
+
+    dispatch(_SetSessionStatusAction(status: SessionStatus.sending, endTime: null));
+
+    // ignore: use_build_context_synchronously
+    unawaited(
+      Routerino.context.pushAndRemoveUntilImmediately(
+        removeUntil: ReceivePage,
+        builder: () => ProgressPage(
+          showAppBar: false,
+          closeSessionOnClose: true,
+          sessionId: session.sessionId,
+        ),
+      ),
+    );
+
+    await controller.sendSelection(selection: selection.keys.toSet());
+    return state.copyWith(
+      sessionState: updatedSession,
+    );
+  }
+
+  @override
+  void after() {
+    // ignore: discarded_futures
+    dispatchAsync(_ReceiveFilesAction());
+  }
+}
