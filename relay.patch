+use axum::http::HeaderMap;
 use std::net::IpAddr;
+use std::str::FromStr;
+
+pub(crate) fn get_client_ip(headers: &HeaderMap, fallback: IpAddr) -> IpAddr {
+    headers
+        .get("x-forwarded-for")
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.split(',').last())
+        .map(|value| value.trim())
+        .and_then(|value| IpAddr::from_str(value).ok())
+        .unwrap_or(fallback)
+}
 
 pub(crate) fn get_ip_group(ip: IpAddr) -> String {
     match ip {
