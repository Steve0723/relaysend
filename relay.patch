+fn parse_ice_server(server: &str) -> Result<RTCIceServer> {
+    let server = server.trim();
+    if server.is_empty() {
+        return Ok(RTCIceServer {
+            urls: Vec::new(),
+            ..Default::default()
+        });
+    }
+
+    let url = Url::parse(server)
+        .map_err(|e| anyhow::anyhow!("Invalid ICE server URL: {e}"))?;
+    let scheme = url.scheme();
+
+    let username = url.username().to_owned();
+    let credential = url.password().unwrap_or_default().to_owned();
+
+    let is_turn = matches!(scheme, "turn" | "turns");
+    anyhow::ensure!(
+        !is_turn || (!username.is_empty() && !credential.is_empty()),
+        "TURN server requires a username and credential"
+    );
+
+    Ok(RTCIceServer {
+        urls: vec![server.to_owned()],
+        username: if is_turn { username } else { String::new() },
+        credential: if is_turn { credential } else { String::new() },
+    })
+}
