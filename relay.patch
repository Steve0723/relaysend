@@ -0,0 +1,1396 @@
+use crate::config::error::AppError;
+use crate::config::state::{AppState, Share, ShareStore, SharedFile};
+use crate::util::ip::get_client_ip;
+use axum::extract::{ConnectInfo, Multipart, Path, State};
+use axum::http::{header, HeaderMap, HeaderValue, StatusCode};
+use axum::response::{Html, IntoResponse, Redirect, Response};
+use base64::engine::general_purpose::STANDARD as BASE64;
+use base64::Engine as _;
+use std::fmt::Write as _;
+use std::net::{IpAddr, SocketAddr};
+use std::sync::LazyLock;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+use tokio::time::sleep;
+use uuid::Uuid;
+
+pub(crate) static MAX_SHARE_BYTES: LazyLock<usize> = LazyLock::new(|| {
+    std::env::var("MAX_SHARE_SIZE_MB")
+        .ok()
+        .and_then(|value| value.parse::<usize>().ok())
+        .unwrap_or(100)
+        .saturating_mul(1024 * 1024)
+});
+
+static MAX_SHARE_FILES: LazyLock<usize> = LazyLock::new(|| {
+    std::env::var("MAX_SHARE_FILES")
+        .ok()
+        .and_then(|value| value.parse::<usize>().ok())
+        .unwrap_or(20)
+});
+
+static MAX_SHARE_UPLOADS_PER_IP_PER_HOUR: LazyLock<u32> = LazyLock::new(|| {
+    std::env::var("MAX_SHARE_UPLOADS_PER_IP_PER_HOUR")
+        .ok()
+        .and_then(|value| value.parse::<u32>().ok())
+        .unwrap_or(100)
+});
+
+static SHARE_TTL_HOURS: LazyLock<u64> = LazyLock::new(|| {
+    std::env::var("SHARE_TTL_HOURS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(24)
+});
+
+static MAX_SHARE_TTL_HOURS: LazyLock<u64> = LazyLock::new(|| {
+    std::env::var("MAX_SHARE_TTL_HOURS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(168)
+        .max(*SHARE_TTL_HOURS)
+});
+
+static MIN_SHARE_TTL_MINUTES: LazyLock<u64> = LazyLock::new(|| {
+    std::env::var("MIN_SHARE_TTL_MINUTES")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(5)
+});
+
+/// Statically configured Basic Auth accounts that may create temporary shares.
+/// No registration endpoint exists; accounts are managed by the server admin.
+pub(crate) static SHARE_AUTH_USERS: LazyLock<Vec<(String, String)>> =
+    LazyLock::new(load_share_auth_users);
+
+fn load_share_auth_users() -> Vec<(String, String)> {
+    let raw = std::env::var("SHARE_AUTH_USERS").unwrap_or_default();
+    let mut users = parse_auth_users(&raw);
+    if users.is_empty() {
+        let username = std::env::var("SHARE_AUTH_USERNAME").unwrap_or_default();
+        let password = std::env::var("SHARE_AUTH_PASSWORD").unwrap_or_default();
+        let username = username.trim().to_owned();
+        let password = password.trim().to_owned();
+        if !username.is_empty() && !password.is_empty() {
+            users.push((username, password));
+        }
+    }
+    users
+}
+
+fn parse_auth_users(raw: &str) -> Vec<(String, String)> {
+    raw.split(',')
+        .filter_map(|entry| {
+            let entry = entry.trim();
+            if entry.is_empty() {
+                return None;
+            }
+            let (username, password) = entry.split_once(':')?;
+            let username = username.trim();
+            let password = password.trim();
+            if username.is_empty() || password.is_empty() {
+                return None;
+            }
+            Some((username.to_owned(), password.to_owned()))
+        })
+        .collect()
+}
+
+/// Compares two byte strings in constant time to avoid leaking account details
+/// through timing.
+fn constant_time_eq(a: &str, b: &str) -> bool {
+    let a = a.as_bytes();
+    let b = b.as_bytes();
+    let mut diff = u8::from(a.len() != b.len());
+    for i in 0..a.len().max(b.len()) {
+        diff |= a.get(i).copied().unwrap_or(0) ^ b.get(i).copied().unwrap_or(0);
+    }
+    diff == 0
+}
+
+fn authenticated_user(headers: &HeaderMap) -> Option<String> {
+    authenticated_user_with(headers, &SHARE_AUTH_USERS)
+}
+
+fn authenticated_user_with(headers: &HeaderMap, users: &[(String, String)]) -> Option<String> {
+    let authorization = headers.get(header::AUTHORIZATION)?.to_str().ok()?;
+    let encoded = authorization.strip_prefix("Basic ")?.trim();
+    let decoded = BASE64.decode(encoded.as_bytes()).ok()?;
+    let decoded = String::from_utf8(decoded).ok()?;
+    let (username, password) = decoded.split_once(':')?;
+    users
+        .iter()
+        .find(|(user, pass)| constant_time_eq(user, username) && constant_time_eq(pass, password))
+        .map(|(user, _)| user.clone())
+}
+
+fn unauthorized_response() -> Response {
+    let mut response = StatusCode::UNAUTHORIZED.into_response();
+    response.headers_mut().insert(
+        header::WWW_AUTHENTICATE,
+        HeaderValue::from_static("Basic realm=\"RelaySend temporary shares\""),
+    );
+    response
+}
+
+pub async fn root() -> Redirect {
+    Redirect::to("/share")
+}
+
+pub async fn share_page(headers: HeaderMap) -> Response {
+    if SHARE_AUTH_USERS.is_empty() {
+        return Html(share_auth_unavailable_page()).into_response();
+    }
+    match authenticated_user(&headers) {
+        Some(username) => Html(share_page_html(&username)).into_response(),
+        None => unauthorized_response(),
+    }
+}
+
+pub async fn create_share(
+    State(state): State<AppState>,
+    ConnectInfo(addr): ConnectInfo<SocketAddr>,
+    headers: HeaderMap,
+    mut multipart: Multipart,
+) -> Result<Redirect, AppError> {
+    if SHARE_AUTH_USERS.is_empty() {
+        return Err(share_error(
+            StatusCode::SERVICE_UNAVAILABLE,
+            "Temporary shares are disabled because no share accounts are configured",
+        ));
+    }
+    if authenticated_user(&headers).is_none() {
+        return Err(share_error(StatusCode::UNAUTHORIZED, "Invalid share login"));
+    }
+
+    let ip: IpAddr = get_client_ip(&headers, addr.ip());
+    let ip_group = crate::util::ip::get_ip_group(ip);
+    {
+        let mut counts = state.share_request_count_map.lock().await;
+        let count = counts.entry(ip_group.clone()).or_default();
+        *count += 1;
+        if *count > *MAX_SHARE_UPLOADS_PER_IP_PER_HOUR {
+            return Err(share_error(
+                StatusCode::TOO_MANY_REQUESTS,
+                "Too many temporary shares from this IP",
+            ));
+        }
+    }
+
+    let share_id = Uuid::new_v4();
+    let share_dir = state.share_store.share_dir(share_id);
+    tokio::fs::create_dir_all(&share_dir).await?;
+
+    let mut text = None;
+    let mut files = Vec::new();
+    let mut expires = None;
+    let mut custom_hours = None;
+
+    while let Some(mut field) = multipart
+        .next_field()
+        .await
+        .map_err(|error| share_error(StatusCode::BAD_REQUEST, error.to_string()))?
+    {
+        match field.name().unwrap_or("") {
+            "text" => {
+                let value = field
+                    .text()
+                    .await
+                    .map_err(|error| share_error(StatusCode::BAD_REQUEST, error.to_string()))?;
+                let value = value.trim().to_owned();
+                if !value.is_empty() {
+                    text = Some(value);
+                }
+            }
+            "expires" => {
+                let value = field
+                    .text()
+                    .await
+                    .map_err(|error| share_error(StatusCode::BAD_REQUEST, error.to_string()))?;
+                expires = Some(value);
+            }
+            "custom_hours" => {
+                let value = field
+                    .text()
+                    .await
+                    .map_err(|error| share_error(StatusCode::BAD_REQUEST, error.to_string()))?;
+                custom_hours = Some(value);
+            }
+            "files" => {
+                if files.len() >= *MAX_SHARE_FILES {
+                    return Err(share_error(
+                        StatusCode::PAYLOAD_TOO_LARGE,
+                        "Too many files in one share",
+                    ));
+                }
+
+                let file_name = field.file_name().unwrap_or("file").to_owned();
+                let mut bytes = Vec::new();
+                let mut size = 0usize;
+
+                while let Some(chunk) = field
+                    .chunk()
+                    .await
+                    .map_err(|error| share_error(StatusCode::BAD_REQUEST, error.to_string()))?
+                {
+                    size += chunk.len();
+                    if size > *MAX_SHARE_BYTES {
+                        return Err(share_error(
+                            StatusCode::PAYLOAD_TOO_LARGE,
+                            "Share is larger than the configured limit",
+                        ));
+                    }
+                    bytes.extend_from_slice(&chunk);
+                }
+
+                if size == 0 {
+                    continue;
+                }
+
+                let index = files.len();
+                let path = share_dir.join(format!("{index}.bin"));
+                tokio::fs::write(&path, &bytes).await?;
+                files.push(SharedFile {
+                    index,
+                    file_name,
+                    size: size as u64,
+                    path,
+                });
+            }
+            _ => {}
+        }
+    }
+
+    if text.is_none() && files.is_empty() {
+        let _ = tokio::fs::remove_dir_all(share_dir).await;
+        return Err(share_error(
+            StatusCode::BAD_REQUEST,
+            "Add text or at least one file",
+        ));
+    }
+
+    let ttl = parse_share_ttl(expires, custom_hours)?;
+    let now = SystemTime::now();
+    let expires_at = now
+        .checked_add(ttl)
+        .ok_or_else(|| share_error(StatusCode::BAD_REQUEST, "Expiration is too large"))?;
+
+    state
+        .share_store
+        .insert(
+            share_id,
+            Share {
+                expires_at,
+                text,
+                files,
+            },
+        )
+        .await;
+
+    Ok(Redirect::to(&format!("/s/{share_id}")))
+}
+
+pub async fn view_share(
+    State(state): State<AppState>,
+    Path(id): Path<Uuid>,
+) -> Result<Html<String>, AppError> {
+    let share =
+        state.share_store.get(&id).await.ok_or_else(|| {
+            share_error(StatusCode::NOT_FOUND, "Share not found or already expired")
+        })?;
+    Ok(Html(view_share_html(id, share)))
+}
+
+pub async fn download_share(
+    State(state): State<AppState>,
+    Path((id, index)): Path<(Uuid, usize)>,
+) -> Result<Response, AppError> {
+    let share =
+        state.share_store.get(&id).await.ok_or_else(|| {
+            share_error(StatusCode::NOT_FOUND, "Share not found or already expired")
+        })?;
+    let file = share
+        .files
+        .get(index)
+        .ok_or_else(|| share_error(StatusCode::NOT_FOUND, "File not found"))?;
+    let bytes = tokio::fs::read(&file.path).await?;
+    let encoded_name = percent_encode(&file.file_name);
+    let content_disposition =
+        format!("attachment; filename=\"download\"; filename*=UTF-8''{encoded_name}");
+
+    let mut headers = HeaderMap::new();
+    headers.insert(
+        header::CONTENT_TYPE,
+        HeaderValue::from_static("application/octet-stream"),
+    );
+    headers.insert(
+        header::CONTENT_DISPOSITION,
+        HeaderValue::from_str(&content_disposition).expect("content disposition is ASCII"),
+    );
+    headers.insert(
+        header::CACHE_CONTROL,
+        HeaderValue::from_static("private, no-store"),
+    );
+
+    Ok((headers, bytes).into_response())
+}
+
+pub fn spawn_share_cleanup(store: ShareStore) {
+    tokio::spawn(async move {
+        loop {
+            sleep(Duration::from_secs(60)).await;
+            let removed = store.cleanup_expired().await;
+            if removed > 0 {
+                tracing::info!("Removed {removed} expired temporary shares");
+            }
+        }
+    });
+}
+
+fn share_error(status: StatusCode, message: impl Into<String>) -> AppError {
+    AppError::status(status, Some(message.into()))
+}
+
+fn parse_share_ttl(
+    expires: Option<String>,
+    custom_hours: Option<String>,
+) -> Result<Duration, AppError> {
+    let default_ttl = Duration::from_secs(*SHARE_TTL_HOURS * 3600);
+    let raw = match expires {
+        Some(value) => value.trim().to_owned(),
+        None => return Ok(default_ttl),
+    };
+    if raw.is_empty() {
+        return Ok(default_ttl);
+    }
+
+    let minutes = if raw.eq_ignore_ascii_case("custom") {
+        let raw_hours = custom_hours.as_deref().unwrap_or("").trim();
+        if raw_hours.is_empty() {
+            return Err(share_error(
+                StatusCode::BAD_REQUEST,
+                "Custom expiration must include hours, for example 2.5",
+            ));
+        }
+        let hours: f64 = raw_hours.parse().map_err(|_| {
+            share_error(
+                StatusCode::BAD_REQUEST,
+                "Custom expiration must be a number of hours, for example 2.5",
+            )
+        })?;
+        if !hours.is_finite() || hours <= 0.0 {
+            return Err(share_error(
+                StatusCode::BAD_REQUEST,
+                "Custom expiration must be greater than 0",
+            ));
+        }
+        (hours * 60.0).round() as u64
+    } else {
+        raw.parse::<u64>()
+            .map_err(|_| share_error(StatusCode::BAD_REQUEST, "Invalid expiration value"))?
+    };
+
+    let min_minutes = *MIN_SHARE_TTL_MINUTES;
+    let max_minutes = *MAX_SHARE_TTL_HOURS * 60;
+    if minutes < min_minutes || minutes > max_minutes {
+        return Err(share_error(
+            StatusCode::BAD_REQUEST,
+            format!("Expiration must be between {min_minutes} minutes and {max_minutes} minutes"),
+        ));
+    }
+
+    Ok(Duration::from_secs(minutes * 60))
+}
