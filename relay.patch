+        self.data_dir.join(id.to_string())
+    }
+
+    pub async fn insert(&self, id: Uuid, share: Share) {
+        self.shares.lock().await.insert(id, share);
+    }
+
+    pub async fn get(&self, id: &Uuid) -> Option<Share> {
+        self.shares.lock().await.get(id).cloned()
+    }
+
+    pub async fn remove(&self, id: &Uuid) {
+        self.shares.lock().await.remove(id);
+        let _ = tokio::fs::remove_dir_all(self.share_dir(*id)).await;
+    }
+
+    pub async fn cleanup_expired(&self, ttl: Duration) -> usize {
+        let expired_ids: Vec<Uuid> = {
+            let shares = self.shares.lock().await;
+            shares
+                .iter()
+                .filter(|(_, share)| share.created_at.elapsed().unwrap_or_default() >= ttl)
+                .map(|(id, _)| *id)
+                .collect()
+        };
+
+        let removed_count = expired_ids.len();
+        for id in expired_ids {
+            self.remove(&id).await;
+        }
+
+        removed_count
+    }
+}
