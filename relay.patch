+class _ReceiveFilesAction extends AsyncReduxAction<WebRTCReceiveService, WebRTCReceiveState> {
+  @override
+  Future<WebRTCReceiveState> reduce() async {
+    final controller = state.controller;
+    final session = state.sessionState;
+    if (controller == null || session == null) {
+      return state;
+    }
+
+    final errorSub = controller.listenError().listen((error) {
+      _logger.warning('WebRTC file error: ${error.fileId} ${error.error}');
+      notifier._fileTransfer.setStatus(sessionId: session.sessionId, fileId: error.fileId, status: FileStatus.failed);
+      if (session.files.containsKey(error.fileId)) {
+        unawaited(
+          controller.sendFileStatus(
+            status: RTCSendFileResponse(
+              id: error.fileId,
+              success: false,
+              error: error.error,
+            ),
+          ),
+        );
+      }
+    });
+
+    try {
+      await for (final receiver in controller.listenReceiving()) {
+        final fileId = await receiver.getFileId();
+        final receivingFile = session.files[fileId];
+        if (receivingFile == null || receivingFile.desiredName == null) {
+          await controller.sendFileStatus(
+            status: RTCSendFileResponse(
+              id: fileId,
+              success: false,
+              error: 'File was not accepted',
+            ),
+          );
+          continue;
+        }
+
+        final destinationPath = _safeDestinationPath(
+          session.destinationDirectory,
+          receivingFile.desiredName!,
+        );
+        await Directory(p.dirname(destinationPath)).create(recursive: true);
+
+        final sink = File(destinationPath).openWrite();
+        var received = 0;
+        var started = false;
+        try {
+          await for (final chunk in receiver.receive()) {
+            if (!started) {
+              notifier._fileTransfer.setStatus(sessionId: session.sessionId, fileId: fileId, status: FileStatus.sending);
+              started = true;
+            }
+
+            sink.add(chunk);
+            received += chunk.length;
+            if (receivingFile.file.size > 0) {
+              notifier._fileTransfer.setProgress(
+                sessionId: session.sessionId,
+                fileId: fileId,
+                progress: (received / receivingFile.file.size).clamp(0, 1),
+              );
+            }
+          }
+
+          await sink.flush();
+          await sink.close();
+          notifier._fileTransfer.setProgress(sessionId: session.sessionId, fileId: fileId, progress: 1);
+          notifier._fileTransfer.setStatus(sessionId: session.sessionId, fileId: fileId, status: FileStatus.finished);
+          await controller.sendFileStatus(
+            status: RTCSendFileResponse(
+              id: fileId,
+              success: true,
+            ),
+          );
+          dispatch(
+            _UpdateReceivedFileAction(
+              fileId: fileId,
+              path: destinationPath,
+              errorMessage: null,
+            ),
+          );
+          await external(notifier._receiveHistory).dispatchAsync(
+            AddHistoryEntryAction(
+              entryId: fileId,
+              fileName: receivingFile.desiredName!,
+              fileType: receivingFile.file.fileType,
+              path: destinationPath,
+              savedToGallery: false,
+              isMessage: false,
+              fileSize: receivingFile.file.size,
+              senderAlias: session.senderAlias,
+              timestamp: DateTime.now().toUtc(),
+            ),
+          );
+        } catch (e, st) {
+          _logger.warning('Failed to receive ${receivingFile.file.fileName}', e, st);
+          try {
+            await sink.close();
+          } catch (_) {}
+          notifier._fileTransfer.setStatus(sessionId: session.sessionId, fileId: fileId, status: FileStatus.failed);
+          await controller.sendFileStatus(
+            status: RTCSendFileResponse(
+              id: fileId,
+              success: false,
+              error: e.toString(),
+            ),
+          );
+          dispatch(
+            _UpdateReceivedFileAction(
+              fileId: fileId,
+              path: null,
+              errorMessage: e.toString(),
+            ),
+          );
+        }
+      }
+
+      final statuses = notifier._fileTransfer.getStatuses(session.sessionId);
+      final hasError = statuses.any((status) => status == FileStatus.failed);
+      dispatch(
+        _SetSessionStatusAction(
+          status: hasError ? SessionStatus.finishedWithErrors : SessionStatus.finished,
+          endTime: DateTime.now().millisecondsSinceEpoch,
+        ),
+      );
+    } catch (e, st) {
+      _logger.warning('WebRTC receive stream failed', e, st);
+      dispatch(
+        _SetSessionStatusAction(
+          status: SessionStatus.finishedWithErrors,
+          endTime: DateTime.now().millisecondsSinceEpoch,
+        ),
+      );
+    } finally {
+      await errorSub.cancel();
+    }
+
+    return state;
+  }
+}
