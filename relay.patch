+/// Removes all signaling devices that were discovered through one relay server.
+///
+/// A dropped WebSocket connection usually does not deliver `Left` messages for
+/// every peer, so the devices must be cleaned up locally instead of remaining
+/// in the list as stale entries.
+class UnregisterSignalingDevicesByServerAction extends ReduxAction<NearbyDevicesService, NearbyDevicesState> {
+  final String signalingServer;
+
+  UnregisterSignalingDevicesByServerAction(this.signalingServer);
+
+  @override
+  NearbyDevicesState reduce() {
+    return state.copyWith(
+      signalingDevices: {
+        for (final entry in state.signalingDevices.entries)
+          if (entry.value.any((device) => device.channels.whereType<SignalingChannel>().any((channel) => channel.signalingServer == signalingServer)))
+            entry.key: entry.value
+                .where((device) => !device.channels.whereType<SignalingChannel>().any((channel) => channel.signalingServer == signalingServer))
+                .toSet(),
+      },
+    );
+  }
+}
