+
+impl ShareStore {
+    pub fn new() -> Self {
+        let data_dir =
+            std::env::var("SHARE_DATA_DIR").unwrap_or_else(|_| "./share-data".to_string());
+        std::fs::create_dir_all(&data_dir).expect("failed to create share data directory");
