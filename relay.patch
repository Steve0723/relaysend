+String _safeDestinationPath(String destinationDirectory, String fileName) {
+  final parts = fileName.replaceAll('\\', '/').split('/').where((part) => part.isNotEmpty && part != '.' && part != '..').toList();
+  if (parts.isEmpty) {
+    return destinationDirectory;
+  }
+  return p.joinAll([destinationDirectory, ...parts]);
+}
