+fn parse_ice_server(server: &str) -> Result<RTCIceServer> {
+    let server = server.trim();
+    if server.is_empty() {
+        return Ok(RTCIceServer {
+            urls: Vec::new(),
+            ..Default::default()
+        });
+    }
+
+    let normalized = normalize_ice_url(server);
+    let url = Url::parse(&normalized).map_err(|e| anyhow::anyhow!("Invalid ICE server URL: {e}"))?;
+    if !matches!(url.scheme(), "turn" | "turns") {
+        return Ok(RTCIceServer {
+            urls: vec![normalized.to_owned()],
+            ..Default::default()
+        });
+    }
+
+    let (_, rest) = normalized.split_once(':').ok_or_else(|| turn_credential_error(server))?;
+    let (userinfo, _) = rest.rsplit_once('@').ok_or_else(|| turn_credential_error(server))?;
+    let (username, credential) = userinfo.split_once(':').ok_or_else(|| turn_credential_error(server))?;
+
+    anyhow::ensure!(
+        !username.is_empty() && !credential.is_empty(),
+        "{}",
+        turn_credential_error(server)
+    );
+
+    Ok(RTCIceServer {
+        urls: vec![normalized.to_owned()],
+        username: username.to_owned(),
+        credential: credential.to_owned(),
+    })
+}
+
+fn normalize_ice_url(server: &str) -> String {
+    if let Some((scheme, rest)) = server.split_once(':') {
+        if rest.starts_with('/') {
+            return format!("{scheme}:{}", rest.trim_start_matches('/'));
+        }
+    }
+    server.to_owned()
+}
+
+fn turn_credential_error(server: &str) -> anyhow::Error {
+    anyhow::anyhow!(
+        "TURN server requires a username and credential in the URL: expected turn:username:password@host:port, got {server}"
+    )
+}
