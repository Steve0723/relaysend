+mod tests {
+    use super::*;
+
+    #[test]
+    fn parse_share_ttl_accepts_preset_minutes() {
+        assert_eq!(
+            parse_share_ttl(Some("60".to_owned()), None).unwrap(),
+            Duration::from_secs(3600)
+        );
+    }
+
+    #[test]
+    fn parse_share_ttl_converts_custom_hours_to_minutes() {
+        assert_eq!(
+            parse_share_ttl(Some("custom".to_owned()), Some("2.5".to_owned())).unwrap(),
+            Duration::from_secs(150 * 60)
+        );
+    }
+
+    #[test]
+    fn parse_share_ttl_rejects_out_of_range() {
+        assert!(parse_share_ttl(Some("1".to_owned()), None).is_err());
+        assert!(parse_share_ttl(Some("custom".to_owned()), Some("100000".to_owned())).is_err());
+    }
+
+    #[test]
+    fn parse_auth_users_parses_comma_separated_accounts() {
+        let users = parse_auth_users("alice:s3cret,bob:hunter2, carol: pass ");
+        assert_eq!(
+            users,
+            vec![
+                ("alice".to_owned(), "s3cret".to_owned()),
+                ("bob".to_owned(), "hunter2".to_owned()),
+                ("carol".to_owned(), "pass".to_owned()),
+            ]
+        );
+    }
+
+    #[test]
+    fn parse_auth_users_skips_invalid_entries() {
+        assert_eq!(
+            parse_auth_users("alice:s3cret,,nodash,charlie:"),
+            vec![("alice".to_owned(), "s3cret".to_owned())]
+        );
+    }
+
+    #[test]
+    fn constant_time_eq_handles_match_and_mismatch() {
+        assert!(constant_time_eq("alice", "alice"));
+        assert!(!constant_time_eq("alice", "bob"));
+        assert!(!constant_time_eq("alice", "alice2"));
+        assert!(!constant_time_eq("", "a"));
+    }
+
+    #[test]
+    fn authenticated_user_accepts_only_configured_basic_credentials() {
+        let users = vec![
+            ("alice".to_owned(), "s3cret".to_owned()),
+            ("bob".to_owned(), "hunter2".to_owned()),
+        ];
+        let mut headers = HeaderMap::new();
+        headers.insert(
+            header::AUTHORIZATION,
+            HeaderValue::from_str(&format!("Basic {}", BASE64.encode(b"alice:s3cret"))).unwrap(),
+        );
+        assert_eq!(
+            authenticated_user_with(&headers, &users).as_deref(),
+            Some("alice")
+        );
+
+        let mut bad_headers = HeaderMap::new();
+        bad_headers.insert(
+            header::AUTHORIZATION,
+            HeaderValue::from_str(&format!("Basic {}", BASE64.encode(b"alice:wrong"))).unwrap(),
+        );
+        assert_eq!(authenticated_user_with(&bad_headers, &users), None);
+    }
+}
