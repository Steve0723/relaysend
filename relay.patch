+Future<String> getSystemDeviceName() async {
+  try {
+    if (kIsWeb) {
+      return 'RelaySend';
+    }
+
+    final plugin = DeviceInfoPlugin();
+    switch (defaultTargetPlatform) {
+      case TargetPlatform.android:
+        final deviceInfo = await plugin.androidInfo;
+        return _firstNonEmpty([deviceInfo.name, deviceInfo.model]);
+      case TargetPlatform.iOS:
+        final deviceInfo = await plugin.iosInfo;
+        return _firstNonEmpty([deviceInfo.name, deviceInfo.localizedModel, deviceInfo.modelName]);
+      case TargetPlatform.macOS:
+        final deviceInfo = await plugin.macOsInfo;
+        return _firstNonEmpty([_withoutDomain(deviceInfo.computerName)]);
+      case TargetPlatform.windows:
+        final deviceInfo = await plugin.windowsInfo;
+        return _firstNonEmpty([_withoutDomain(deviceInfo.computerName)]);
+      case TargetPlatform.linux:
+        final deviceInfo = await plugin.linuxInfo;
+        return _firstNonEmpty([deviceInfo.prettyName, deviceInfo.name]);
+      case TargetPlatform.fuchsia:
+        return 'RelaySend';
+    }
+  } catch (_) {
+    return 'RelaySend';
+  }
+}
+
+String _withoutDomain(String value) {
+  final trimmed = value.trim();
+  final dot = trimmed.indexOf('.');
+  return dot > 0 ? trimmed.substring(0, dot) : trimmed;
+}
+
+String _firstNonEmpty(List<String> values) {
+  for (final value in values) {
+    final trimmed = value.trim();
+    if (trimmed.isNotEmpty) {
+      return trimmed;
+    }
+  }
+  return 'RelaySend';
+}
