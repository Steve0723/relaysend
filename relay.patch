+      resolvedTarget = freshTarget;
+    }
+
+    final signalingServers = resolvedTarget.channels.whereType<SignalingChannel>().map((channel) => channel.signalingServer).toSet();
+    if (signalingServers.isEmpty) {
+      state = state.updateSession(
+        sessionId: sessionId,
+        state: (s) => s?.copyWith(
+          status: SessionStatus.finishedWithErrors,
+          endTime: DateTime.now().millisecondsSinceEpoch,
+          errorMessage: 'WebRTC signaling connection is not available',
+        ),
+      );
+      return;
+    }
+
+    ref.redux(signalingProvider).dispatch(SetupSignalingConnection());
+
+    var liveTarget = _findLiveSignalingDevice(resolvedTarget.fingerprint, signalingServers);
+    liveTarget ??= await _waitForLiveSignalingDevice(resolvedTarget.fingerprint, signalingServers);
+    resolvedTarget = liveTarget ?? resolvedTarget;
