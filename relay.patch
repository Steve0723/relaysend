@@ -14,6 +16,97 @@ pub struct ClientState {
 
 pub type IpRequestCountMap = Arc<Mutex<HashMap<String, u32>>>;
 
+/// IP group -> number of active WebSocket connections.
+pub type IpConnectionCountMap = Arc<Mutex<HashMap<String, u32>>>;
+
+/// IP group -> number of temporary share uploads in the current hour.
+pub type ShareRequestCountMap = Arc<Mutex<HashMap<String, u32>>>;
+
+/// In-memory index for temporary browser shares. File payloads live on disk.
+#[derive(Clone)]
+pub struct ShareStore {
+    pub shares: Arc<Mutex<HashMap<Uuid, Share>>>,
+    pub data_dir: PathBuf,
+}
+
+impl ShareStore {
+    pub fn new() -> Self {
+        let data_dir =
+            std::env::var("SHARE_DATA_DIR").unwrap_or_else(|_| "./share-data".to_string());
+        std::fs::create_dir_all(&data_dir).expect("failed to create share data directory");
+        Self {
+            shares: Arc::new(Mutex::new(HashMap::new())),
+            data_dir: PathBuf::from(data_dir),
+        }
+    }
+
+    pub fn share_dir(&self, id: Uuid) -> PathBuf {
+        self.data_dir.join(id.to_string())
+    }
+
+    pub async fn insert(&self, id: Uuid, share: Share) {
+        self.shares.lock().await.insert(id, share);
+    }
+
+    pub async fn get(&self, id: &Uuid) -> Option<Share> {
+        let share = self.shares.lock().await.get(id).cloned();
+        if let Some(share) = share {
+            if share.is_expired() {
+                self.remove(id).await;
+                return None;
+            }
+            Some(share)
+        } else {
+            None
+        }
+    }
+
+    pub async fn remove(&self, id: &Uuid) {
+        self.shares.lock().await.remove(id);
+        let _ = tokio::fs::remove_dir_all(self.share_dir(*id)).await;
+    }
+
+    pub async fn cleanup_expired(&self) -> usize {
+        let now = SystemTime::now();
+        let expired_ids: Vec<Uuid> = {
+            let shares = self.shares.lock().await;
+            shares
+                .iter()
+                .filter(|(_, share)| now >= share.expires_at)
+                .map(|(id, _)| *id)
+                .collect()
+        };
+
+        let removed_count = expired_ids.len();
+        for id in expired_ids {
+            self.remove(&id).await;
+        }
+
+        removed_count
+    }
+}
+
+#[derive(Clone)]
+pub struct Share {
+    pub expires_at: SystemTime,
+    pub text: Option<String>,
+    pub files: Vec<SharedFile>,
+}
+
+impl Share {
+    pub fn is_expired(&self) -> bool {
+        SystemTime::now() >= self.expires_at
+    }
+}
+
+#[derive(Clone)]
+pub struct SharedFile {
+    pub index: usize,
+    pub file_name: String,
+    pub size: u64,
+    pub path: PathBuf,
+}
+
