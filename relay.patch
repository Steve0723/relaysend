+Future<void> editRelayServers(BuildContext context, Ref ref) async {
+  final servers = [...ref.read(signalingProvider).signalingServers];
+  final controller = TextEditingController(text: servers.join('\n'));
+
+  final result = await showDialog<String>(
+    context: context,
+    builder: (context) {
+      return AlertDialog(
+        title: const Text('Relay server'),
+        content: SizedBox(
+          width: 420,
+          child: TextField(
+            controller: controller,
+            maxLines: 6,
+            decoration: const InputDecoration(
+              hintText: 'wss://relay.example.com/v1/ws',
+            ),
+          ),
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.pop(context),
+            child: const Text('Cancel'),
+          ),
+          FilledButton(
+            onPressed: () => Navigator.pop(context, controller.text),
+            child: const Text('Save'),
+          ),
+        ],
+      );
+    },
+  );
+  controller.dispose();
+
+  if (result == null) {
+    return;
+  }
+
+  final nextServers = result
+      .split('\n')
+      .map((server) => server.trim())
+      .where((server) => server.isNotEmpty)
+      .toSet()
+      .toList();
+
+  await ref.read(persistenceProvider).setSignalingServers(nextServers);
+  ref.redux(signalingProvider).dispatch(SetSignalingServersAction(nextServers));
+  ref.redux(signalingProvider).dispatch(SetupSignalingConnection());
+}
+
+Future<void> editIceServers(BuildContext context, Ref ref) async {
+  final servers = [...ref.read(signalingProvider).stunServers];
+  final controller = TextEditingController(text: servers.join('\n'));
+  String? error;
+
+  final result = await showDialog<String>(
+    context: context,
+    builder: (context) {
+      return StatefulBuilder(
+        builder: (context, setState) {
+          return AlertDialog(
+            title: const Text('STUN/TURN server'),
+            content: SizedBox(
+              width: 420,
+              child: TextField(
+                controller: controller,
+                maxLines: 8,
+                decoration: InputDecoration(
+                  hintText:
+                      'stun:relay.example.com:3478\nturn:username:password@relay.example.com:3478?transport=tcp',
+                  helperText:
+                      'One address per line. TURN requires username and password before @.',
+                  errorText: error,
+                  errorMaxLines: 4,
+                ),
+              ),
+            ),
+            actions: [
+              TextButton(
+                onPressed: () => Navigator.pop(context),
+                child: const Text('Cancel'),
+              ),
+              FilledButton(
+                onPressed: () {
+                  final nextServers = _parseIceServers(controller.text);
+                  final invalid = nextServers
+                      .map(_invalidIceServerError)
+                      .whereType<String>()
+                      .toList();
+                  if (invalid.isNotEmpty) {
+                    setState(() {
+                      error =
+                          'TURN server requires "username:password@host" in every turn: URL.\n${invalid.join("\n")}';
+                    });
+                    return;
+                  }
+                  Navigator.pop(context, controller.text);
+                },
+                child: const Text('Save'),
+              ),
+            ],
+          );
+        },
+      );
+    },
+  );
+  controller.dispose();
+
+  if (result == null) {
+    return;
+  }
+
+  final nextServers = result
+      .split('\n')
+      .map((server) => server.trim())
+      .where((server) => server.isNotEmpty)
+      .toSet()
+      .toList();
+
+  await ref.read(persistenceProvider).setStunServers(nextServers);
+  ref.redux(signalingProvider).dispatch(SetStunServersAction(nextServers));
+}
+
+List<String> _parseIceServers(String input) {
+  return input
+      .split('\n')
+      .map((server) => server.trim())
+      .where((server) => server.isNotEmpty)
+      .toSet()
+      .toList();
+}
+
+String? _invalidIceServerError(String server) {
+  final normalized = server.trim().toLowerCase();
+  if (!normalized.startsWith('turn:') && !normalized.startsWith('turns:')) {
+    return null;
+  }
+
+  final hasCredentials = RegExp(
+    r'^turns?:/{0,2}[^@/?#:]+:[^@/?#]+@',
+  ).hasMatch(normalized);
+  return hasCredentials
+      ? null
+      : 'Invalid TURN URL (missing username:password@): $server';
+}
