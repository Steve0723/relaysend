+</body>
+</html>
+"#,
+        ttl = *SHARE_TTL_HOURS,
+        max_mb = max_mb,
+        max_files = *MAX_SHARE_FILES,
+    )
+}
+
+fn view_share_html(id: Uuid, share: Share) -> String {
+    let ttl = Duration::from_secs(*SHARE_TTL_HOURS * 3600);
+    let elapsed = share.created_at.elapsed().unwrap_or_default();
+    let remaining = ttl.saturating_sub(elapsed);
+    let remaining_hours = remaining.as_secs() / 3600;
+    let remaining_minutes = (remaining.as_secs() % 3600) / 60;
+
+    let text_html = share.text.as_deref().map_or_else(String::new, |text| {
+        format!(
+            "<section><h2>Text</h2><pre>{}</pre></section>",
+            html_escape(text)
+        )
+    });
+
+    let mut files_html = String::new();
+    if !share.files.is_empty() {
+        files_html.push_str("<section><h2>Files</h2><ul>");
+        for file in &share.files {
+            let _ = write!(
+                files_html,
+                "<li><a href=\"/s/{id}/download/{}\">{}</a> <span class=\"meta\">{}</span></li>",
+                file.index,
+                html_escape(&file.file_name),
+                human_size(file.size)
+            );
+        }
+        files_html.push_str("</ul></section>");
+    }
+
+    format!(
+        r#"<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>RelaySend Share</title>
+  <style>
+    :root {{
+      color-scheme: light dark;
+      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
+      line-height: 1.5;
+    }}
+    * {{ box-sizing: border-box; }}
+    body {{
+      width: min(100%, 760px);
+      margin: 0 auto;
+      padding: clamp(16px, 4vw, 32px) clamp(12px, 4vw, 24px)
+        calc(28px + env(safe-area-inset-bottom));
+    }}
+    .meta {{ color: #777; font-size: 14px; }}
+    pre {{
+      white-space: pre-wrap;
+      word-break: break-word;
+      overflow-wrap: anywhere;
+      background: #f5f5f5;
+      padding: 12px;
+      border-radius: 8px;
+    }}
+    button {{ padding: 8px 12px; border-radius: 8px; cursor: pointer; }}
+    ul {{ margin: 0; padding: 0; list-style: none; }}
+    li {{
+      display: flex;
+      flex-wrap: wrap;
+      gap: 4px 10px;
+      align-items: baseline;
+      padding: 8px 0;
+      border-bottom: 1px solid rgba(127, 127, 127, 0.25);
+    }}
+    a {{ color: #0b6bcb; word-break: break-word; overflow-wrap: anywhere; }}
+    @media (max-width: 600px) {{
+      h1 {{ font-size: 1.35rem; }}
+      button {{ width: 100%; }}
+      .meta {{ font-size: 13px; }}
+    }}
+  </style>
+</head>
+<body>
+  <main>
+    <h1>RelaySend Share</h1>
+    <p class="meta">Link expires in {remaining_hours}h {remaining_minutes}m.</p>
+    <button id="copy" type="button">Copy link</button>
+    {text_html}
+    {files_html}
+  </main>
+  <script>
+    document.getElementById('copy').addEventListener('click', () => {{
+      navigator.clipboard.writeText(location.href).then(() => {{
+        document.getElementById('copy').textContent = 'Copied';
+      }});
+    }});
+  </script>
+</body>
+</html>
+"#,
+        remaining_hours = remaining_hours,
+        remaining_minutes = remaining_minutes,
+        text_html = text_html,
+        files_html = files_html,
+    )
+}
+
+fn html_escape(value: &str) -> String {
+    value
+        .replace('&', "&amp;")
+        .replace('<', "&lt;")
+        .replace('>', "&gt;")
+        .replace('"', "&quot;")
+        .replace('\'', "&#39;")
+}
+
+fn percent_encode(value: &str) -> String {
+    let mut encoded = String::new();
+    for byte in value.bytes() {
+        if byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.') {
+            encoded.push(byte as char);
+        } else {
+            let _ = write!(encoded, "%{byte:02X}");
+        }
+    }
+    encoded
+}
+
+fn human_size(bytes: u64) -> String {
+    if bytes >= 1024 * 1024 * 1024 {
+        format!("{:.1} GB", bytes as f64 / (1024.0 * 1024.0 * 1024.0))
+    } else if bytes >= 1024 * 1024 {
+        format!("{:.1} MB", bytes as f64 / (1024.0 * 1024.0))
+    } else if bytes >= 1024 {
+        format!("{:.1} KB", bytes as f64 / 1024.0)
+    } else {
+        format!("{bytes} B")
+    }
+}
